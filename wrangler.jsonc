// Cloudflare Workers Builds config: serve this repo as a static site.
// worker/index.js runs first only for the videos, to answer byte-range requests (Safari needs them to play video),
// and for /loop, a short download address for TV remotes.
{
  "name": "peachs",
  "compatibility_date": "2026-10-06",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/signage/*.mp4", "/docs/demo/*.mp4", "/loop"]
  }
}
