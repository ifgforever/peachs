{
  "name": "romesjoy-sites",
  "private": true,
  "version": "1.0.0",
  "description": "Rome's Joy Companies: concept sites, admin panel and in-store screens on Cloudflare Workers",
  "scripts": {
    "build": "echo \"No build step: static sites plus worker/index.js\"",
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "db:schema:local": "wrangler d1 execute romesjoy-admin --local --file worker/schema.sql",
    "db:seed:local": "wrangler d1 execute romesjoy-admin --local --file worker/seed.sql",
    "db:schema:remote": "wrangler d1 execute romesjoy-admin --remote --file worker/schema.sql",
    "db:seed:remote": "wrangler d1 execute romesjoy-admin --remote --file worker/seed.sql",
    "test:smoke": "node worker/smoke-test.mjs http://localhost:8787"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
