// Cloudflare Workers config: one Worker serves the static sites and the /api/* admin backend.
// Setup steps are in admin/README.md.
{
  "name": "peachs",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only these paths run the Worker; everything else is served straight from the files.
    // /api/* is the admin backend; the .mp4 paths and /loop get byte-range video serving (worker/lib/video.js).
    "run_worker_first": ["/api/*", "/signage/*.mp4", "/docs/demo/*.mp4", "/loop"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "romesjoy-admin",
      "database_id": "3545d6c2-619a-497b-8f15-1c30b71e6014"
    }
  ],
  // Photo uploads (event photos, artwork images). Bucket created 2026-10-13 in the same account.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "romesjoy-media" }],
  "vars": {
    "PUBLIC_BASE_URL": ""
  },
  "observability": { "enabled": true }
}
